from PIL import Image, ImageDraw, ImageFont
import os

# Create a clean, modern, professional vector-style logo image (PNG)
# Dimensions: 200x200 pixels with a transparent background
img = Image.new("RGBA", (200, 200), (0, 0, 0, 0))
draw = ImageDraw.Draw(img)

# Draw a sleek rounded background badge (Deep Indigo/Blue gradient feel)
draw.rounded_rectangle([10, 10, 190, 190], radius=40, fill="#2563eb")

# Draw a minimalist white wallet/rupee symbol graphic
# Wallet outline
draw.rounded_rectangle([45, 65, 155, 145], radius=15, outline="#ffffff", width=6)
# Wallet clasp/flap
draw.rounded_rectangle([115, 85, 165, 115], radius=8, fill="#60a5fa", outline="#ffffff", width=4)
# Rupee symbol or accent dot
draw.ellipse([70, 90, 90, 110], fill="#ffffff")

# Save the logo locally as logo.png
logo_path = "logo.png"
img.save(logo_path, "PNG")
